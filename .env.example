# GameLearn AI Flutter frontend - build-time configuration template.
# Copy values into .env or pass as --dart-define flags.
# Run with: flutter run --dart-define-from-file=.env

# Active Ngrok tunnel URL (configured for current backend instance):
API_BASE_URL=https://idealness-esquire-upriver.ngrok-free.dev

# Local development alternatives:
# API_BASE_URL=http://10.0.2.2:8080        # Android emulator -> local host
# API_BASE_URL=http://localhost:8080       # Windows desktop / macOS / Web / iOS simulator

# Environment identifier (dev | demo | staging | prod)
APP_ENV=dev
