{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 15000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.79", "--headless"],
      "enabled": true,
      "timeout": 60000
    },
    "mysql": {
      "type": "local",
      "command": ["npx", "-y", "@database-mcp/mysql@0.4.2"],
      "environment": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "gamelearn_ro",
        "MYSQL_DATABASE": "gamelearn",
        "MYSQL_PASSWORD": "{env:GAMELEARN_MCP_RO_PASSWORD}"
      },
      "enabled": true,
      "timeout": 60000
    }
  }
}
