# GameLearn AI backend configuration template.
#
# Copy this file to ".env", fill in real values, and load it before running
# the backend. NEVER commit the real .env file - it is ignored by .gitignore.
#
# Loading examples:
#   Git Bash / Linux:   set -a; source .env; set +a
#   PowerShell:         Get-Content .env | ForEach-Object { $n, $v = $_ -split '=', 2; [Environment]::SetEnvironmentVariable($n, $v, 'Process') }
#   IntelliJ:          Run Configuration > Environment variables

SPRING_PROFILES_ACTIVE=dev

# --- Database (required) ---
DB_URL=jdbc:mysql://localhost:3306/gamelearn
DB_USERNAME=root
DB_PASSWORD=<your-real-password-here>

# --- CORS ---
# Comma-separated origin patterns. Production must list exact origins,
# e.g. https://app.gamelearn.example
CORS_ALLOWED_ORIGINS=http://localhost:[*]

# --- Authentication (required from Phase 2) ---
# Generate e.g. with: openssl rand -base64 48
# Minimum 32 characters; the backend fails fast without it.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# --- Prepared for later AI phases (placeholders only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Phase 6: AI learning-path generation (PATH-002) ---
# Required only when gamelearn.ai.learning-path.enabled=true (default in dev/prod).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- Gate 23: RAG evidence sidecar (AI Tutor grounding) ---
# Required only when gamelearn.ai.rag.enabled=true (default false).
# The sidecar binds localhost only; this token is a service-bound secret:
# generate with e.g. openssl rand -hex 32, never commit a real value.
RAG_SIDECAR_TOKEN=
RAG_SIDECAR_PORT=8431
RAG_SIDECAR_BASE_URL=http://127.0.0.1:8431
# Set to true only when the sidecar above is running and reachable;
# when false (default) the tutor keeps its exact legacy behavior, and
# when true-but-unreachable the tutor fails safe (503, never ungrounded).
GAMELEARN_AI_RAG_ENABLED=false
