# GameLearn AI Flutter frontend - build-time configuration template.
# Copy values into your build/run command as --dart-define flags.
# NEVER commit real secrets; this frontend holds no secrets at all.

# API_BASE_URL=http://10.0.2.2:8080        # Android emulator -> host
# API_BASE_URL=http://localhost:8080       # Windows desktop / iOS sim
# API_BASE_URL=https://api.gamelearn.example  # production

# APP_ENV=dev                              # dev | demo | prod (display only)
